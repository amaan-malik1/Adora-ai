# Server
PORT=3001

# Database (PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@localhost:5432/adora?schema=public"

# Clerk (from Clerk Dashboard)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Required for Clerk webhooks (from Clerk Dashboard → Webhooks → Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Google AI (Gemini / Veo)
GEMINI_CLOUD_API_KEY=...

# Cloudinary (for image/video uploads)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
